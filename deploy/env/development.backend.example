# Copy to /opt/sawiyaa-dev/sawiyaa-backend-v1/.env.development.
APP_ENV=development
NODE_ENV=development
APP_VERSION=development
PORT=7000
APP_URL=http://SERVER_HOST:8080
WEB_APP_URL=http://SERVER_HOST:8080
APP_BASE_URL=http://SERVER_HOST:8080
CORS_ORIGINS=http://SERVER_HOST:8080
LOG_LEVEL=debug
DATABASE_URL=postgresql://sawiyaa_dev:<password>@postgres:5432/sawiyaa_dev
POSTGRES_DB=sawiyaa_dev
POSTGRES_USER=sawiyaa_dev
POSTGRES_PASSWORD=<development-password>
PGDATA=/var/lib/postgresql/data/pgdata
JWT_ACCESS_SECRET=<development-secret>
JWT_REFRESH_SECRET=<different-development-secret>
VIDEO_PROVIDER_DEFAULT=DAILY
DAILY_API_KEY=<development-daily-key>
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_WEBHOOK_SECRET=<development-webhook-secret>
CORPORATE_CODE_PEPPER=<at-least-32-character-development-secret>
MAIL_PROVIDER=smtp
MAIL_FROM=dev@sawiyaa.local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
SAWIYAA_DEV_COUNTRY_CODE=
GEOIP_ENABLED=false
GEOIP_DATABASE_PATH=/opt/sawiyaa/geoip/GeoLite2-Country.mmdb
TRUSTED_PROXY_MODE=none
CLOUDFLARE_COUNTRY_HEADER_ENABLED=false
NOTIFICATION_QUEUE_ENABLED=false
DAILY_ATTENDANCE_QUEUE_ENABLED=false
THROTTLE_STORE=memory
