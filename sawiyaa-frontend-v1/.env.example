# Sawiyaa frontend canonical environment contract.
# Copy to .env and change values for local or production use.
# NEXT_PUBLIC_* values are public and are embedded during next build.

# Proxy and application URLs
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:7000
NEXT_PUBLIC_APP_NAME=Sawiyaa
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_CHAT_SOCKET_URL=http://127.0.0.1:7000

# Public identity and feature flags
NEXT_PUBLIC_GOOGLE_CLIENT_ID=__OPTIONAL_PUBLIC_CLIENT_ID__
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__OPTIONAL_PUBLIC_STRIPE_KEY__
NEXT_PUBLIC_SHOW_DETAILED_ERRORS=true
NEXT_PUBLIC_SHOW_TEST_CREDENTIALS=false
NEXT_PUBLIC_PRACTITIONER_LOGIN_OTP_ENABLED=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
NEXT_PUBLIC_DEBUG_PRACTITIONER_WIZARD=0
NEXT_PUBLIC_TOKEN_EXPIRY_DAYS=7
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY_DAYS=30

# Frontend server runtime
HOSTNAME=0.0.0.0
PORT=3000
