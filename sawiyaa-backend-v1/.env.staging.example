# Standardized package staging example
# Copy into the approved staging secret store or deploy env, then fill in real staging values there.

# Core app/runtime
APP_ENV=staging
NODE_ENV=production
PORT=7000
APP_NAME=sawiyaa
SERVICE_NAME=sawiyaa-backend-v1
APP_URL=https://staging-api.example.com
APP_BASE_URL=https://staging.example.com
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?schema=public
CORS_ORIGINS=https://staging.example.com,https://admin-staging.example.com
LOG_HTTP_ENABLED=true
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_STACK_ENABLED=false
LOG_NEST_INTERNAL_ENABLED=false
LOG_DIR=logs
LOG_SLOW_REQUEST_MS=1000
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_SIZE=20m

# Availability and trusted country resolution
AVAILABILITY_FUTURE_WEEKS_ALLOWED=4
AVAILABILITY_RETENTION_MONTHS=12
AVAILABILITY_REPEAT_PREVIEW_TTL_MINUTES=10
GEOIP_ENABLED=false
GEOIP_DATABASE_PATH=
TRUSTED_PROXY_MODE=single
CLOUDFLARE_COUNTRY_HEADER_ENABLED=false

# Throttling / Rate limiting (recommended: redis in production-like envs)
THROTTLE_STORE=redis
REDIS_URL=redis://<host>:6379
THROTTLE_KEY_PREFIX=sawiyaa:throttle
THROTTLE_KEY_HASH_SECRET=

# Step-up (re-auth) for sensitive admin/finance actions

# Accounting reconciliation operations
ACCOUNTING_RECONCILIATION_ENABLED=true
ACCOUNTING_RECONCILIATION_LOOKBACK_DAYS=7
ACCOUNTING_RECONCILIATION_BATCH_SIZE=100
ACCOUNTING_RECONCILIATION_CRON=0 3 * * *
ACCOUNTING_RECONCILIATION_ALERTS_ENABLED=false

# Authentication
JWT_ACCESS_SECRET=<staging-access-secret>
JWT_REFRESH_SECRET=<staging-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sawiyaa-backend-v1
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_PASSWORD_LOCKOUT_MAX_ATTEMPTS=
AUTH_PASSWORD_LOCKOUT_DURATION_MINUTES=
AUTH_OTP_LOCKOUT_MAX_ATTEMPTS=
AUTH_OTP_LOCKOUT_DURATION_MINUTES=
AUTH_OTP_CODE_LENGTH=6
AUTH_LOGIN_OTP_TTL_MINUTES=10
AUTH_RESET_PASSWORD_TTL_MINUTES=15
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
PRACTITIONER_LOGIN_OTP_REQUIRED=true
PRACTITIONER_OTP_QA_CAPTURE_ENABLED=false
PRACTITIONER_OTP_QA_CAPTURE_ACCOUNTS=
PRACTITIONER_OTP_QA_CAPTURE_PATH=

# Google and notification providers
GOOGLE_CLIENT_ID=<staging-google-client-id>
GOOGLE_CLIENT_SECRET=<staging-google-client-secret>
GOOGLE_CALLBACK_URL=https://staging-api.example.com/api/v1/auth/google/callback
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@example.com
MAIL_HOST=<staging-smtp-host>
MAIL_PORT=587
MAIL_USER=<staging-smtp-user>
MAIL_PASS=<staging-smtp-password>
MAIL_SECURE=false
DEV_OTP_EMAIL_REDIRECT=
DEV_OTP_BYPASS_DELIVERY_FAILURES=false
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com
SMS_PROVIDER=twilio

# Daily video
VIDEO_PROVIDER_DEFAULT=DAILY
DAILY_API_KEY=<staging-daily-api-key>
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_WEBHOOK_SECRET=<staging-daily-webhook-secret>
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Payment redirects
PAYMENT_SUCCESS_URL=https://staging.example.com/payment/success
PAYMENT_FAILED_URL=https://staging.example.com/payment/failed
PAYMENT_PENDING_URL=https://staging.example.com/payment/pending

# Stripe sandbox / test mode
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com

# Paymob sandbox / test mode
PAYMOB_MODE=test
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_EGP_CARD_INTEGRATION_ID=
PAYMOB_EGP_WALLET_INTEGRATION_ID=
PAYMOB_USD_CARD_INTEGRATION_ID=
PAYMOB_INTEGRATION_ID=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_INTENTION_BASE_URL=https://flashapi.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://flashapi.paymob.com

# Session timing / hold behavior
SESSION_PAYMENT_RESERVATION_MINUTES=15
SESSION_RUNTIME_PREPARE_LEAD_MINUTES=1440

# Auth posture
AUTH_COOKIE_AUTH_ENABLED=false
AUTH_CSRF_ENFORCEMENT_ENABLED=false
AUTH_CSRF_COOKIE_NAME=fayed_csrf_token
AUTH_CSRF_HEADER_NAME=x-csrf-token


# Finance and corporate sponsorship
FINANCE_VAT_ENABLED=false
FINANCE_VAT_RATE_PERCENT=0
FINANCE_GATEWAY_FEE_RATE_PERCENT=0
FINANCE_GATEWAY_FEE_FIXED_AMOUNT=0
CORPORATE_CODE_PEPPER=<staging-corporate-pepper-at-least-32-characters>

# Optional operational settings
LOG_LEVEL=info
LOG_PRETTY=false
CONFIG_HTTP_ENABLED=false
CONFIG_HTTP_TOKEN=

# Notes:
# - Use sandbox credentials only.
# - Do not commit real values into the repository.
# - Test accounts are staging data, not env vars.
