# Sawiyaa backend production example
# Copy this file to your deployment secret store or keep it as the source of truth for production envs.

# Core app/runtime
APP_ENV=production
NODE_ENV=production
PORT=7000
APP_NAME=sawiyaa-backend-v1
SERVICE_NAME=sawiyaa-backend-v1
APP_URL=https://sawiyaa.com
APP_BASE_URL=https://sawiyaa.com
# Public web origin used in transactional session links.
WEB_APP_URL=https://your-production-domain.example
CORS_ORIGINS=https://sawiyaa.com
CONFIG_HTTP_ENABLED=false
CONFIG_HTTP_TOKEN=
LOG_LEVEL=info
LOG_PRETTY=false
LOG_HTTP_ENABLED=true
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_STACK_ENABLED=false
LOG_NEST_INTERNAL_ENABLED=false
LOG_DIR=/app/logs
LOG_SLOW_REQUEST_MS=1000
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_SIZE=20mb

# Availability policy
AVAILABILITY_FUTURE_WEEKS_ALLOWED=4
AVAILABILITY_RETENTION_MONTHS=12
AVAILABILITY_REPEAT_PREVIEW_TTL_MINUTES=10

# Throttling / Rate limit store
THROTTLE_STORE=memory
REDIS_URL=
THROTTLE_KEY_PREFIX=sawiyaa:throttle
THROTTLE_KEY_HASH_SECRET=

# Step-up / re-auth

# Database
DATABASE_URL=postgresql://sawiyaa:<change-me>@postgres:5432/sawiyaa?schema=public

# JWT
JWT_ACCESS_SECRET=<change-me>
JWT_REFRESH_SECRET=<change-me>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sawiyaa-backend-v1
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
# Optional lockout overrides; omit to use the database/default policy.
AUTH_OTP_CODE_LENGTH=6
AUTH_LOGIN_OTP_TTL_MINUTES=10
AUTH_RESET_PASSWORD_TTL_MINUTES=15
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_COOKIE_AUTH_ENABLED=false
AUTH_CSRF_ENFORCEMENT_ENABLED=false
AUTH_CSRF_COOKIE_NAME=sawiyaa_csrf_token
AUTH_CSRF_HEADER_NAME=x-csrf-token
PRACTITIONER_LOGIN_OTP_REQUIRED=true
PRACTITIONER_OTP_QA_CAPTURE_ENABLED=false
PRACTITIONER_OTP_QA_CAPTURE_ACCOUNTS=
PRACTITIONER_OTP_QA_CAPTURE_PATH=

# Google Auth
GOOGLE_CLIENT_ID=<change-me>
GOOGLE_CLIENT_SECRET=<change-me>
GOOGLE_CALLBACK_URL=https://sawiyaa.com/api/v1/auth/google/callback

# Email / SMS. SMTP is the selected production transport in this template.
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@sawiyaa.com
MAIL_HOST=<change-me>
MAIL_PORT=587
MAIL_USER=<change-me>
MAIL_PASS=<change-me>
MAIL_SECURE=false
DEV_OTP_EMAIL_REDIRECT=
DEV_OTP_BYPASS_DELIVERY_FAILURES=false
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com
SMS_PROVIDER=twilio

# Video
VIDEO_PROVIDER_DEFAULT=DAILY
DAILY_API_KEY=<change-me>
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_WEBHOOK_SECRET=<generate-a-strong-random-secret-and-configure-the-same-secret-in-daily>

# Session booking
SESSION_PAYMENT_RESERVATION_MINUTES=15
SESSION_RUNTIME_PREPARE_LEAD_MINUTES=1440

# Payment redirect URLs
PAYMENT_SUCCESS_URL=https://sawiyaa.com/payment/success
PAYMENT_FAILED_URL=https://sawiyaa.com/payment/failed
PAYMENT_PENDING_URL=https://sawiyaa.com/payment/pending

# Trusted request-country resolution
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=/opt/sawiyaa/geoip/GeoLite2-Country.mmdb
TRUSTED_PROXY_MODE=single
CLOUDFLARE_COUNTRY_HEADER_ENABLED=false

# Payments - Stripe
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com

# Payments - Paymob
PAYMOB_MODE=test
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_EGP_CARD_INTEGRATION_ID=
PAYMOB_EGP_WALLET_INTEGRATION_ID=
PAYMOB_USD_CARD_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_INTENTION_BASE_URL=https://flashapi.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://flashapi.paymob.com
PAYMOB_INTEGRATION_ID=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

# Optional Zoom compatibility settings
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Reconciliation
ACCOUNTING_RECONCILIATION_ENABLED=false
ACCOUNTING_RECONCILIATION_LOOKBACK_DAYS=7
ACCOUNTING_RECONCILIATION_BATCH_SIZE=100
ACCOUNTING_RECONCILIATION_CRON=0 3 * * *
ACCOUNTING_RECONCILIATION_ALERTS_ENABLED=false

# Currency/method routing is database-authoritative. Do not set
# PAYMENT_PROVIDER_ROUTES_JSON.

# Finance
FINANCE_VAT_ENABLED=false
FINANCE_VAT_RATE_PERCENT=0
FINANCE_GATEWAY_FEE_RATE_PERCENT=0
FINANCE_GATEWAY_FEE_FIXED_AMOUNT=0

# Corporate sponsorship
CORPORATE_CODE_PEPPER=<change-me-to-a-long-random-secret-at-least-32-characters>
