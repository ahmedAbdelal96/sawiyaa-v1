{
  "name": "sawiyaa-backend-v1",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "node scripts/kill-port-6000.js",
    "start": "nest start",
    "prestart:dev": "node scripts/kill-port-6000.js",
    "start:dev": "nest start --watch",
    "prestart:debug": "node scripts/kill-port-6000.js",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "node scripts/kill-port-6000.js && npm run prisma:migrate:deploy && npm run prisma:generate",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "config:validate:production": "node scripts/validate-runtime-config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "node scripts/prisma-generate-safe.js",
    "staging:package:verify": "ts-node scripts/package-staging-readiness.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:deploy:practitioner-translation-search-indexes": "node scripts/deploy-practitioner-translation-search-indexes.js",
    "db:rollback:practitioner-translation-search-indexes": "node scripts/deploy-practitioner-translation-search-indexes.js --rollback",
    "db:status:practitioner-translation-search-indexes": "node scripts/deploy-practitioner-translation-search-indexes.js --status",
    "prisma:studio": "prisma studio",
    "session-codes:backfill": "ts-node --preferTsExts prisma/scripts/backfill-session-codes.ts",
    "session-codes:concurrency-test": "ts-node --preferTsExts prisma/scripts/verify-session-code-concurrency.ts",
    "prisma:seed": "ts-node --preferTsExts prisma/seed.ts",
    "seed:session-access": "ts-node --preferTsExts prisma/scripts/seed-session-access.ts",
    "db:bootstrap:config": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/bootstrap-config.ts",
    "qa:settlement:fixture": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/create-settlement-qa-scenario.ts",
    "qa:finance:settlement-seed": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/create-settlement-qa-scenario.ts",
    "qa:finance:settlement-clean": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/clean-finance-settlement-qa-scenario.ts",
    "db:bootstrap:development-payment-routes": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/bootstrap-development-payment-routes.ts",
    "db:bootstrap:payment-routes": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/bootstrap-payment-routes.ts",
    "db:seed:production": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/seed-production-baseline.ts",
    "db:verify:production-seed": "ts-node -r tsconfig-paths/register --preferTsExts prisma/scripts/verify-production-baseline.ts",
    "db:verify:production-ready": "npm run db:verify:production-seed",
    "db:bootstrap:production": "node scripts/bootstrap-production.js",
    "db:bootstrap:paymob-provider-control": "node scripts/bootstrap-paymob-provider-control.js",
    "db:sync:permissions": "ts-node --preferTsExts prisma/scripts/sync-permissions.ts",
    "db:sync:countries": "ts-node --preferTsExts prisma/scripts/sync-countries.ts",
    "db:reconcile:practitioner-change-requests": "ts-node --preferTsExts prisma/scripts/reconcile-practitioner-change-requests.ts",
    "seed:practitioner-finance": "ts-node --preferTsExts prisma/seed/practitioner-finance.seed.ts",
    "seed:qa:testsprite": "ts-node --preferTsExts prisma/seed/qa.testsprite.seed.ts",
    "seed:qa:instant-booking": "ts-node -r tsconfig-paths/register --preferTsExts scripts/seed-instant-booking-qa.ts",
    "db:reset": "prisma migrate reset",
    "logs:analyze": "ts-node --preferTsExts scripts/analyze-logs.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.9",
    "maxmind": "^5.0.6",
    "ms": "^2.1.3",
    "nodemailer": "^8.0.7",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "handlebars": "4.7.9",
    "fast-uri": "3.1.2",
    "effect": "3.21.2",
    "defu": "6.1.7",
    "brace-expansion": "2.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../prisma/seed/modules"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@health/(.*)$": "<rootDir>/health/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
